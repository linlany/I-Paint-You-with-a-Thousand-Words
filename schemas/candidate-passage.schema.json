{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/literary-image-collage/candidate-passage.schema.json",
  "title": "CandidatePassage",
  "type": "object",
  "required": ["candidate_id", "text", "source_id", "source_url", "location"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "record_id": {"type": "string"},
    "author": {"type": "string"},
    "work": {"type": "string"},
    "work_id": {"type": "string"},
    "document_id": {"type": "string"},
    "article_id": {"type": "string"},
    "source_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "location": {"type": "string", "minLength": 1},
    "license_status": {"type": "string"},
    "query_facets": {"type": "array", "items": {"type": "string"}},
    "retrieval_score": {"type": "number"},
    "semantic_score": {"type": "number"},
    "scene_fit": {"type": "number", "minimum": 0, "maximum": 1},
    "visual_conflict": {"type": "number", "minimum": 0, "maximum": 1},
    "source_quality": {"type": "number", "minimum": 0, "maximum": 1},
    "quote_completeness": {"type": "number", "minimum": 0, "maximum": 1},
    "contradiction_risk": {"type": "number", "minimum": 0, "maximum": 1},
    "translated_text": {"type": "string"},
    "source_language": {"type": "string"},
    "translation_status": {"type": "string"},
    "embedding": {"type": "array", "items": {"type": "number"}}
  },
  "additionalProperties": true
}
